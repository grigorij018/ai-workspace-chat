# Copy this file to `.env` for local work. Never commit populated secrets.
# All model traffic for the hackathon workspace must go through MWS GPT.

# Runtime
ENV=prod
OPEN_WEBUI_PORT=3000
WEBUI_SECRET_KEY=
OPENWEBUI_SECRET=

# Primary model gateway: MWS GPT (OpenAI-compatible API)
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=https://api.gpt.mws.ru/v1
OPENAI_API_KEY=

# MWS GPT defaults for backend routing/orchestration.
# If OPENAI_* is unset in some backend paths, these can be used as fallback.
MWS_API_KEY=
MWS_BASE_URL=https://api.gpt.mws.ru/v1
MWS_ROUTER_MODEL_NAME=MWS Auto Router

# Optional multi-endpoint form used by Open WebUI when you need more than one route.
# Keep both lists aligned by index. Leave empty for the default single MWS endpoint above.
OPENAI_API_BASE_URLS=
OPENAI_API_KEYS=

# Disable Ollama by default for the hackathon demo path.
# Flip to `true` only when you intentionally need a local Ollama sidecar.
ENABLE_OLLAMA_API=false
OLLAMA_BASE_URL=http://ollama:11434

# Optional local image generation backend
# AUTOMATIC1111_BASE_URL=http://localhost:7860

# Multimodal defaults for the unified chat path.
# Audio STT and image generation should stay on the same MWS-compatible gateway unless intentionally overridden.
AUDIO_STT_ENGINE=openai
AUDIO_STT_OPENAI_API_BASE_URL=https://api.gpt.mws.ru/v1
AUDIO_STT_OPENAI_API_KEY=
AUDIO_STT_MODEL=
AUDIO_STT_SUPPORTED_CONTENT_TYPES=audio/wav,audio/mpeg,audio/mp3,audio/webm,audio/mp4,video/mp4
WHISPER_MODEL=base
WHISPER_LANGUAGE=

ENABLE_IMAGE_GENERATION=true
IMAGE_GENERATION_ENGINE=openai
IMAGE_GENERATION_MODEL=
IMAGES_OPENAI_API_BASE_URL=https://api.gpt.mws.ru/v1
IMAGES_OPENAI_API_KEY=

# RAG / research defaults.
# Embedding requests are also model traffic, so point the OpenAI-compatible embedding path at MWS.
RAG_EMBEDDING_ENGINE=openai
RAG_EMBEDDING_MODEL=
RAG_OPENAI_API_BASE_URL=https://api.gpt.mws.ru/v1
RAG_OPENAI_API_KEY=
CONTENT_EXTRACTION_ENGINE=

# Web search can use any configured provider; keep provider keys only in `.env`.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=duckduckgo
WEB_SEARCH_RESULT_COUNT=5
WEB_FETCH_MAX_CONTENT_LENGTH=20000

# Optional defaults for model UX.
# `DEFAULT_MODELS` keeps manual model selection available in chat.
# `TASK_MODEL` and `TASK_MODEL_EXTERNAL` can be used by routing/task helpers.
DEFAULT_MODELS=
TASK_MODEL=
TASK_MODEL_EXTERNAL=

# App behavior
CORS_ALLOW_ORIGIN=*
FORWARDED_ALLOW_IPS=*
RESET_CONFIG_ON_START=false

# Persistence
DATABASE_URL=sqlite:////app/backend/data/webui.db

# Optional Postgres settings for future docker-compose / pgvector scenarios
POSTGRES_DB=aiworkspace
POSTGRES_USER=aiworkspace
POSTGRES_PASSWORD=aiworkspace

# Telemetry discipline
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Secret discipline:
# - keep real values only in `.env`, CI secrets, or your secret manager
# - do not paste keys into docs, screenshots, or issue comments
# - rotate any credential immediately if it was ever committed
